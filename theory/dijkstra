	public static int[] dijkstraList(List<List<Edge>> graph, int n,  int start) {
		int[] dist = new int[n]; 
		boolean[] visited = new boolean[n];
		
		// 전체를 초기화
		for(int i = 0; i<n; i++) {
			dist[i]= INF;
		}
		// 시작은 0
		dist[start] = 0;

		// 모든 정점을 하나씩 돌아서 방문하지 않은 정점 중 dis값이 가장 작은 정점 찾기
		for(int i = 0; i<n; i++) {
			int u = -1;
			int minDist =INF;
			for(int j =0;j<n; j++) {
				if(!visited[j] && dist[j]<minDist) {
					minDist = dist[j];
					u=j;
				}
			}
			
			if(u == -1)break;
			visited[u] = true;
			
			for(Edge edge:graph.get(u)) {
				
			}
		}
		
		
		return dist;
	}
}
